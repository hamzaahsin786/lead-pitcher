# --- Gemini (FREE tier) ---
# Get a free key: sign in at https://aistudio.google.com/apikey -> "Create API key"
# Paste it below. The key is only used for the "Filter with AI" step and is never logged.
GEMINI_API_KEY=PASTE_YOUR_FREE_KEY_HERE
# You can change the model if Google renames it. Default works on the free tier.
GEMINI_MODEL=gemini-2.0-flash

# --- Safety limits for WhatsApp sending ---
# Max messages per 24 hours (keep low — unofficial automation)
DAILY_LIMIT=40
# Random delay between messages, in seconds
MIN_DELAY_SEC=45
MAX_DELAY_SEC=90

# --- Server ---
PORT=3000

# --- Testing only: log "would send" instead of sending ---
DRY_RUN=false
